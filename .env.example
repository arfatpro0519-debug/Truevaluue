# Truevalue — copier vers .env puis renseigner les valeurs utiles.
# Node >= 22.13 (node:sqlite natif). Le repli JSON reste disponible si besoin.

# Serveur
PORT=3000
DATA_DIR=data
SYNC_INTERVAL_SECS=600
# Seuil minimal avant de désigner une « meilleure catégorie » (défaut 30)
# CALIBRATION_MIN_N=30

# Sécurité — ADMIN_PASSCODE est OBLIGATOIRE en production et protège /legacy.
ADMIN_PASSCODE=
# Sessions signées : secret fort et stable, sinon sessions invalidées au redémarrage.
SESSION_SECRET=
NODE_ENV=development
# Ne PAS activer sans avoir vérifié la réglementation locale (Telegram Stars).
PAYMENTS_ENABLED=0

# Bot Telegram (alertes + Mini App)
TELEGRAM_BOT_TOKEN=
# Secret partagé vérifié sur /api/billing/telegram-webhook et les commandes.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRO_STARS_PRICE=1500
# Règle des alertes (valeur nette, liquidité PM, âge max des données, plafond/jour).
ALERT_NET_MIN_PP=4
ALERT_PM_MIN_LIQUIDITY_USD=5000
ALERT_MAX_AGE_S=600
ALERT_DAILY_CAP=10

# GitHub (push)
# GITHUB_TOKEN=          # PAT avec scope repo / contents:write
# GITHUB_REPO=Mamaart80/Truevaluue
# GITHUB_BRANCH=refonte-v2

# Render (déploiement)
# RENDER_API_KEY, RENDER_SERVICE_ID et RENDER_BASE_URL sont des secrets/Métadonnées
# de ton compte Render : à renseigner dans .env et/ou le dashboard.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_BASE_URL=

# Déploiement Render (plan gratuit) + Cloudflare (KV et cron gratuits)
# 'local' en dev, 'cloudflare' sur Render : le disque n'y est pas persistant.
STORAGE_BACKEND=local
# 'internal' = timer intégré au process ; 'external' = cron Cloudflare -> /api/cron/sync
SYNC_MODE=internal
# Secret partagé envoyé dans l'en-tête X-Cron-Secret (SECRET).
CRON_SECRET=
# Cloudflare Workers KV (SECRETS).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Arbworld / Betfair — renseigner un contact avant tout scraping en production.
ARBWORLD_BASE=https://arbworld.net/fr/moneyway
SCRAPER_CONTACT=
CACHE_TTL_SECS=20
STALE_TTL_SECS=900
# Au-delà de cet âge (secondes), une source est affichée en retard (⚠) dans l'UI.
SOURCE_STALE_SECS=600

# Polymarket — disponibilité légale variable (France notamment).
# Passer à 0 pour retirer tous les liens « Voir le marché ».
POLYMARKET_ENABLED=1
POLYMARKET_URL=https://gamma-api.polymarket.com
SHOW_PM_LINKS=1

# Résultats réels
ESPN_ENABLED=1
SPORTSCORE_URL=https://sportscore.com
SPORTSCORE_API_KEY=
SPORTSCORE_HOST=
SPORTSCORE_DISABLED=0
