# Configuration des 4 sources de données football et de la sécurité commerciale
PORT=3000
DATA_DIR=data
SYNC_INTERVAL_SECS=600
# Taille d'échantillon minimale pour désigner une meilleure catégorie de signaux
# CALIBRATION_MIN_N=30

# Sécurité & Monétisation (laisser vide en dev ; configurer en production)
ADMIN_PASSCODE=
PAYMENTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRO_STARS_PRICE=1500

# Arbworld / Betfair
ARBWORLD_BASE=https://arbworld.net/fr/moneyway
SCRAPER_CONTACT=
CACHE_TTL_SECS=20
STALE_TTL_SECS=900

# Polymarket (Gamma API)
POLYMARKET_ENABLED=1
POLYMARKET_URL=https://gamma-api.polymarket.com

# ESPN (API publique)
ESPN_ENABLED=1

# SportScore
SPORTSCORE_URL=https://sportscore.com
SPORTSCORE_API_KEY=
SPORTSCORE_HOST=
SPORTSCORE_DISABLED=0
